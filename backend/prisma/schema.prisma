generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  inspector
  supervisor
}

enum InspectionStatus {
  draft
  submitted
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime     @default(now())
  inspections  Inspection[]
}

model Site {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  address     String
  createdAt   DateTime     @default(now())
  inspections Inspection[]
}

/// Inspection IDs are generated by the client (crypto.randomUUID) so offline creates are idempotent.
model Inspection {
  id          String           @id @db.Uuid
  siteId      String           @db.Uuid
  inspectorId String           @db.Uuid
  title       String
  notes       String           @default("")
  status      InspectionStatus @default(draft)
  /// [{ id, label, result: 'pass'|'fail'|'na'|null, comment }]
  items       Json
  /// Starts at 1, +1 on every server write. Used for optimistic concurrency.
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  site      Site @relation(fields: [siteId], references: [id])
  inspector User @relation(fields: [inspectorId], references: [id])

  @@index([inspectorId, updatedAt])
  @@index([updatedAt])
}

/// One row per successfully applied sync operation. Makes POST /sync idempotent (AC6).
model ProcessedOp {
  opId      String   @id @db.Uuid
  userId    String   @db.Uuid
  result    Json
  createdAt DateTime @default(now())
}

/// Default checklist used when creating an inspection (seeded).
model ChecklistTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// [{ id, label }]
  items     Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}
