# Copy to backend/.env and adjust. Never commit real values.
NODE_ENV=development
PORT=4000
# Local Docker Compose database (see docker-compose.yml). Use your Neon/Render URL in production.
DATABASE_URL=postgresql://siteward:siteward@localhost:5433/siteward?schema=public
# Used by `npm run test -w backend` (the test suite resets this database).
TEST_DATABASE_URL=postgresql://siteward:siteward@localhost:5433/siteward_test?schema=public
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
# Demo tools (AC8): POST /api/dev/fail-next-sync (supervisor only) and random sync failures.
DEMO_TOOLS=false
FAIL_SYNC_RATE=0
# Passwords for the seeded demo accounts (inspector@siteward.test / supervisor@siteward.test).
SEED_INSPECTOR_PASSWORD=choose-an-inspector-password
SEED_SUPERVISOR_PASSWORD=choose-a-supervisor-password
